# 2026-09-17. Para testes locais, trocar por http://localhost:8000/api.
UNI_API_BASE_URL=https://operacao.souuni.com/api

# Credencial da identidade técnica de leitura do cubo (usuário de serviço "Cubo Corporativo",
# perfil somente-leitura). NUNCA preencher este arquivo com o valor real e commitar/zipar —
# o valor deve ser obtido pelo canal seguro combinado com o responsável pela integração,
# nunca por chat/e-mail. Ver docs/integracao-uni/acesso.md seção 5.
UNI_API_TOKEN=
