APP_ENV=development
POSTGRES_DB=opr_gamification
POSTGRES_USER=opr
POSTGRES_PASSWORD=opr
DATABASE_URL=postgresql+psycopg://opr:opr@db:5432/opr_gamification
# Em producao, use um dominio HTTPS real (nao localhost) - o UNI Localiza monta o link publico de
# geolocalizacao a partir desta URL, e a Geolocation API do navegador so funciona em HTTPS (ou em
# localhost, que so serve para desenvolvimento). Ex.: FRONTEND_URL=https://workspace.souuni.com
FRONTEND_URL=http://localhost:3000
AUTH_SECRET_KEY=defina-uma-chave-longa-e-segura-com-mais-de-32-caracteres
DEBUG_PERFORMANCE=false

# Envio de e-mail (código de 6 dígitos de "esqueci minha senha"). Desligado por padrão: com
# EMAIL_ENABLED=false nada é enviado. A senha SMTP fica só no .env da VM, nunca no Git. Porta 587 usa
# STARTTLS; 465 usa SSL direto. Google Workspace: smtp.gmail.com + "senha de app" da conta remetente.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operacional@souuni.com
SMTP_FROM_NAME=UNI Workspace
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8000

# Integração IXC (webservice v1)
IXC_API_BASE_URL=https://sistema.souuni.com
IXC_API_TOKEN=
IXC_API_VERIFY_SSL=true
# Sincronização automática periódica - desligada por padrão de propósito (ver docs/plano-integracao-ixc.md)
IXC_SYNC_ENABLED=false
IXC_SYNC_INTERVAL_MINUTES=20

# Integração OPA Suite
OPA_API_BASE_URL=
OPA_API_TOKEN=
OPA_API_VERIFY_SSL=true
OPA_SYNC_ENABLED=false
OPA_SYNC_INTERVAL_MINUTES=20
OPA_SYNC_LOOKBACK_DAYS=1
