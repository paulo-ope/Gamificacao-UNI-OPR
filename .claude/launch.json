{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "backend"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "frontend"],
      "port": 3000
    },
    {
      "name": "backend-local",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["backend/scripts/run_local.py"],
      "port": 8000
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--webpack", "-p", "3001"],
      "port": 3001
    }
  ]
}
